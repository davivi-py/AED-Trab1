#include <stdio.h>

int busca_binaria_iterativa(int v[], int n, int e) {
    int inicio = 0, fim = n - 1;

    while (inicio <= fim) {
        int meio = (inicio + fim) / 2;

        if (v[meio] == e)
            return 1;
        else if (v[meio] < e)
            inicio = meio + 1;
        else
            fim = meio - 1;
    }

    return 0;
}

int main() {
    int n;
    scanf("%d", &n);

    int v[n];
    for (int i = 0; i < n; i++)
        scanf("%d", &v[i]);

    int e;
    scanf("%d", &e);

    if (busca_binaria_iterativa(v, n, e))
        printf("SIM\n");
    else
        printf("NAO\n");

    return 0;
}
