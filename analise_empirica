// TRABALHO 1 - Codigo Auxiliar de Analise (tempo e contagem de operacoes)
// NAO eh entregue no Run.Codes - apenas para gerar dados do relatorio (PIOR CASO)
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

long long comparacoes, atribuicoes;

// ---------- Algoritmo 1: Inversao ----------
void inversao(int *v, int n){
    int tmp;
    for(int i = 0; i < n/2; i++){
        tmp = v[i];              atribuicoes++;
        v[i] = v[n-1-i];         atribuicoes++;
        v[n-1-i] = tmp;          atribuicoes++;
    }
}

// ---------- Algoritmo 2: Busca Sequencial ----------
int busca_sequencial(int *v, int n, int p){
    for(int i = 0; i < n; i++){
        comparacoes++;
        if(v[i] == p) return 1;
    }
    return 0;
}

// ---------- Algoritmo 3: Busca Binaria Iterativa ----------
int busca_iterativa(int *v, int n, int p){
    int inicio = 0, fim = n - 1, meio;
    atribuicoes += 2;
    while(inicio <= fim){
        comparacoes++;
        meio = (inicio + fim) / 2;   atribuicoes++;
        comparacoes++;
        if(v[meio] == p) return 1;
        comparacoes++;
        if(v[meio] < p){
            inicio = meio + 1;       atribuicoes++;
        }else{
            fim = meio - 1;          atribuicoes++;
        }
    }
    return 0;
}

// ---------- Algoritmo 4: Busca Binaria Recursiva ----------
int busca_recursiva(int *v, int inicio, int fim, int p){
    comparacoes++;
    if(inicio > fim) return 0;
    int meio = (inicio + fim) / 2;   atribuicoes++;
    comparacoes++;
    if(v[meio] == p) return 1;
    comparacoes++;
    if(v[meio] < p)
        return busca_recursiva(v, meio + 1, fim, p);
    else
        return busca_recursiva(v, inicio, meio - 1, p);
}

// ---------- Utilitarios ----------
int *gerar_vetor(int n){
    int *v = malloc(sizeof(int) * n);
    for(int i = 0; i < n; i++) v[i] = i;   // vetor ordenado
    return v;
}

int main(){
    int tamanhos[] = {1000, 50000, 100000, 500000, 1000000};
    int qtd_tamanhos = 5;
    int repeticoes = 100;

    FILE *arq = fopen("resultados.csv", "w");
    if(arq == NULL){
        printf("Erro ao criar o arquivo resultados.csv\n");
        return 1;
    }
    fprintf(arq, "algoritmo,n,tempo_medio_s,comparacoes,atribuicoes\n");

    for(int t = 0; t < qtd_tamanhos; t++){
        int n = tamanhos[t];
        int *v = gerar_vetor(n);
        int p_ausente = -1; // pior caso: elemento nao esta no vetor

        // ---- Inversao ----
        comparacoes = 0; atribuicoes = 0;
        clock_t inicio_t = clock();
        for(int r = 0; r < repeticoes; r++) inversao(v, n);
        clock_t fim_t = clock();
        double tempo = ((double)(fim_t - inicio_t) / CLOCKS_PER_SEC) / repeticoes;
        fprintf(arq, "inversao,%d,%f,%lld,%lld\n", n, tempo, comparacoes / repeticoes, atribuicoes / repeticoes);

        // ---- Busca Sequencial ----
        comparacoes = 0; atribuicoes = 0;
        inicio_t = clock();
        for(int r = 0; r < repeticoes; r++) busca_sequencial(v, n, p_ausente);
        fim_t = clock();
        tempo = ((double)(fim_t - inicio_t) / CLOCKS_PER_SEC) / repeticoes;
        fprintf(arq, "busca_sequencial,%d,%f,%lld,%lld\n", n, tempo, comparacoes / repeticoes, atribuicoes / repeticoes);

        // ---- Busca Binaria Iterativa ----
        comparacoes = 0; atribuicoes = 0;
        inicio_t = clock();
        for(int r = 0; r < repeticoes; r++) busca_iterativa(v, n, p_ausente);
        fim_t = clock();
        tempo = ((double)(fim_t - inicio_t) / CLOCKS_PER_SEC) / repeticoes;
        fprintf(arq, "busca_iterativa,%d,%f,%lld,%lld\n", n, tempo, comparacoes / repeticoes, atribuicoes / repeticoes);

        // ---- Busca Binaria Recursiva ----
        comparacoes = 0; atribuicoes = 0;
        inicio_t = clock();
        for(int r = 0; r < repeticoes; r++) busca_recursiva(v, 0, n - 1, p_ausente);
        fim_t = clock();
        tempo = ((double)(fim_t - inicio_t) / CLOCKS_PER_SEC) / repeticoes;
        fprintf(arq, "busca_recursiva,%d,%f,%lld,%lld\n", n, tempo, comparacoes / repeticoes, atribuicoes / repeticoes);

        free(v);
    }

    fclose(arq);
    printf("Arquivo resultados.csv gerado com sucesso!\n");
    return 0;
}
